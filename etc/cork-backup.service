[Unit]
Description=Back up the Cork database to Cloudflare R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cork
Group=cork
WorkingDirectory=/srv/cork
EnvironmentFile=/etc/cork/backup.env
ExecStart=/srv/cork/.venv/bin/python bin/backup.py

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cork
