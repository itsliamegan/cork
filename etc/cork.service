[Unit]
Description=Cork application server
Requires=cork.socket
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=cork
Group=cork
WorkingDirectory=/srv/cork
ExecStart=/srv/cork/.venv/bin/gunicorn \
	--workers 2 \
	--access-logfile - \
	--error-logfile - \
	app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cork

[Install]
WantedBy=multi-user.target
